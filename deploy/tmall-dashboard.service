[Unit]
Description=Tmall Daily Dashboard (Streamlit)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/tmall-dashboard/current
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/ubuntu
Environment=TMALL_DATA_DIR=/opt/tmall-dashboard/data
Environment=TMALL_CACHE_DIR=/opt/tmall-dashboard/.cache
ExecStart=/opt/tmall-dashboard/.venv/bin/python -m streamlit run app.py --server.address=127.0.0.1 --server.port=8501 --server.headless=true --server.maxUploadSize=25 --browser.gatherUsageStats=false
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
